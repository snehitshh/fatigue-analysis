VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional, supported for newer Supabase projects that prefer publishable keys.
# If both are present, VITE_SUPABASE_ANON_KEY is used first.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public study details shown on the informed-consent screen (not secrets).
#
# REQUIRED before collection starts: only these two. The test is blocked until
# both are set.
VITE_STUDY_INSTITUTION=TIET,SPARC
VITE_STUDY_CONTACT=research-contact@example.org
#
# OPTIONAL: fill these once your IRB / protocol details are finalised. If left
# blank, the consent screen shows "To be confirmed" and the test still runs.
VITE_STUDY_RETENTION=For example: five years after study completion
VITE_STUDY_PROTOCOL_ID=FATIGUE-V3-PILOT
VITE_STUDY_DATA_USE=Research analysis and development of fatigue measurement methods
VITE_PHYSICAL_PROTOCOL_NAME=Researcher-approved light movement protocol
VITE_PHYSICAL_PROTOCOL_INSTRUCTIONS=Describe the exact movement, posture, cadence, and stop criteria approved for this study
